# terminal-setup · macOS packages (brew bundle --file=install/Brewfile)
# zsh comes with macOS; python3 with the Command Line Tools Homebrew needs anyway.

brew "tmux"                     # ≥ 3.6
brew "ncurses"                  # tmux-256color terminal description (macOS's ncurses lacks it)
brew "git"
brew "jq"
brew "fzf"
brew "eza"
brew "bat"
brew "micro"
brew "btop"
brew "fastfetch"
brew "entr"                     # tmux-autoreload
brew "ansifilter"               # tmux-logging: clean logs
brew "git-delta"
brew "starship"
brew "ripgrep"                  # rg: search inside files
brew "fd"                       # find files by name
brew "zoxide"                   # z: cd that learns your folders
brew "lazygit"                  # git in the terminal (also from the git tab)
brew "tealdeer"                 # tldr: short examples of any command
brew "yq"                       # jq for YAML (mikefarah/yq)
brew "shellcheck"               # finds bugs in shell scripts (micro and make check use it)
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "coreutils"                # gdircolors (ls colours), gnumfmt
brew "flock"                    # the system monitor's lock (Linux has it built in)
brew "bash"                     # tmux-autoreload needs bash ≥ 4.2 (macOS's /bin/bash is 3.2)

cask "font-jetbrains-mono-nerd-font"
